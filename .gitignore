__pycache__/
*.py[cod]
.venv/
.venv313/
venv/
# Every .env variant, not just the exact name. A safety copy (.env.backup, .env.bak,
# .env.local) holds the same secrets as the original, and an exact-name rule let one
# get committed. .env.example is the only one that may be tracked.
.env
.env.*
!.env.example
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Engagement state and vector indexes are client-confidential - never commit.
# Matched broadly on purpose. These were previously listed by exact path, which meant
# a second data directory (data313/, data/chroma-313/ for the CrewAI interpreter) fell
# straight through and got committed. A rule that only holds for the directory names
# you thought of is not a confidentiality control.
/data/
/data[-_0-9]*/
*.sqlite3
*.sqlite3-journal
chroma*/
demo/output/
