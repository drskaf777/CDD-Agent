# Anthropic credentials. An `ant auth login` profile also works with no key set.
ANTHROPIC_API_KEY=

# Model selection (see docs/ARCHITECTURE.md § Model choices)
CDD_MODEL=claude-opus-5
CDD_CRITIC_MODEL=claude-opus-5
CDD_EFFORT=high

# Required only for identity-linked API keys, which are scoped to a person rather
# than a workspace. Without it the API returns 400 "anthropic-workspace-id is
# required". Find it in the Console under Settings -> Workspaces.
CDD_WORKSPACE_ID=

# CrewAI execution traces for the Critic. Set either way explicitly - CrewAI only
# prompts interactively while this is unset, and it prompts once per crew kickoff.
CDD_CREWAI_TRACING=true

# Storage
CDD_DATA_DIR=./data
CDD_CHROMA_DIR=./data/chroma

# Embeddings: "default" (Chroma ONNX, offline) or "hash" (deterministic, tests only)
CDD_EMBEDDINGS=default

# Set 1 to run the pipeline with scripted stub LLM responses (no API calls).
CDD_OFFLINE=0
